  "trusted_headers": ["X-Real-IP", "X-Forwarded-For"],
  "enable_reverse_lookup": true,
  "enable_port_lookup": true,
  "enable_profiling": false,
  "allow_custom_ip": true,
  "hybrid_mode": true,
  "auto_detect": false,
  "databases": {
